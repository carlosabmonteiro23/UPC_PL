% Header/footer. #1 = HAP or PT
\newcommand{\setupheader}[1]{%
  \pagestyle{fancy}\fancyhf{}%
  \fancyhead[L]{\includegraphics[width=4.5cm]{logo-upc}}%
  \fancyhead[R]{\small #1 -- \CandName\\ Ref. concurso: \PostRef}%
  \fancyfoot[R]{\small P\'agina \thepage}%
  \fancypagestyle{plain}{\fancyhf{}%
    \fancyhead[L]{\includegraphics[width=4.5cm]{logo-upc}}%
    \fancyhead[R]{\small #1 -- \CandName\\ Ref. concurso: \PostRef}%
    \fancyfoot[R]{\small P\'agina \thepage}}%
}

