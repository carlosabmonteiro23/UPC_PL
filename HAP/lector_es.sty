% Supporting documents: \certlink{label}{text} in the body, \certpdf{label}{file} in the annex.
% If the PDF is not yet in documents_justificacio/, a placeholder page is printed.
\newcommand{\certlink}[2]{\hyperlink{cert-#1.1}{(#2)}}
\newcommand{\certpdf}[2]{%
  \IfFileExists{./documents_justificacio/#2}{%
    \includepdf[pages=-,link,linkname=cert-#1,pagecommand={\thispagestyle{empty}}]{./documents_justificacio/#2}}{%
    \clearpage\hypertarget{cert-#1.1}{}\thispagestyle{empty}\vspace*{5cm}
    \begin{center}\Large\color{red}Falta el documento justificativo:\\ \texttt{documents\_justificacio/\detokenize{#2}}\end{center}\clearpage}}
